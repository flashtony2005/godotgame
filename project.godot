; Engine configuration file.
config_version=5

[application]

config/name="Cinderwatch · Godot"
config/description="A self-playing 3D isometric tower defense, recreated in Godot 4 from kevintngo's single-file HTML game."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.06, 1)

[debug]

gdscript/warnings/treat_warnings_as_errors=false
