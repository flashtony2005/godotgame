; Engine configuration file.
config_version=5

[application]

config/name="Cinderwatch · Godot"
config/description="A self-playing 3D isometric tower defense, recreated in Godot 4.4 with high-detail procedural geometry, PBR shaders, all 5 biomes, crumble/rise transitions, weather, FX, and procedural audio."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=2
environment/defaults/default_clear_color=Color(0.015, 0.02, 0.038, 1)

[debug]

gdscript/warnings/treat_warnings_as_errors=false
